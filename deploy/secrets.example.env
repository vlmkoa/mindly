# Template for deploy/secrets.env (gitignored — NEVER commit the real one).
# Generate the password with `openssl rand -hex 24` — hex only, because the
# value is embedded inside DATABASE_URL and must need no URL-encoding.
# Keep the filled file safe (it is also your recovery copy).
#
# ⚠ DATABASE_URL host differs by stage:
#   - Docker Compose (live):  @db:5432        (compose service name)
#   - Kubernetes (milestone): @postgres:5432  (k8s Service name)
#
# Compose usage: file sits at /opt/mindly/deploy/secrets.env on the box;
# docker-compose.prod.yml reads it via env_file. Rotation: edit values, then
#   docker compose -f docker-compose.prod.yml up -d
#
# K8s usage (milestone 2): create the Secret, then restart consumers:
#   kubectl -n mindly create secret generic mindly-secrets --from-env-file=deploy/secrets.env
#   kubectl -n mindly rollout restart deployment/api statefulset/postgres

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://koan:PASTE_POSTGRES_PASSWORD_HERE@db:5432/koan
ANTHROPIC_API_KEY=
